{
  "info": {
    "name": "API de Solicitudes de Soporte Técnico",
    "description": "Pruebas funcionales de todos los endpoints. Ejecutar en orden con el Runner de Postman: cada petición guarda los ids que usan las siguientes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Emails únicos en cada ejecución completa, para poder repetirla sin reiniciar la API",
          "if (pm.info.requestName === \"Registrar cliente\") { pm.collectionVariables.set(\"sufijo\", Date.now()); }"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "sufijo",
      "value": ""
    }
  ],
